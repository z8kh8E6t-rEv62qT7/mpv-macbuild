set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CMAKE_SYSTEM_NAME Darwin)
set(VCPKG_OSX_ARCHITECTURES arm64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../toolchains/brew-llvm.cmake")
set(VCPKG_C_FLAGS "$ENV{OPTIMIZATIONS} $ENV{LLVM_C_BUNDLE} $ENV{INCLUDE_PATH}")
set(VCPKG_CXX_FLAGS "$ENV{OPTIMIZATIONS} $ENV{LLVM_CXX_BUNDLE} $ENV{INCLUDE_PATH}")
set(VCPKG_LINKER_FLAGS "$ENV{OPTIMIZATIONS} -fuse-ld=$ENV{LD64_LLD} $ENV{LLVM_LINK_BUNDLE} $ENV{LINK_PATH} -L$ENV{FFMPEG_PREFIX}/lib -L$ENV{SOURCE_PREFIX}/lib -L$ENV{VCPKG_TARGET_PREFIX}/lib")
