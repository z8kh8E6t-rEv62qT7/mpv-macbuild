+static char *mac_bundle_resource_path_from_executable(void *talloc_ctx)
+{
+    char probe[1];
+    uint32_t size = sizeof(probe);
+    if (_NSGetExecutablePath(probe, &size) == 0)
+        return NULL;
+    if (!size)
+        return NULL;
+
+    char *buffer = talloc_array(NULL, char, size);
+    if (_NSGetExecutablePath(buffer, &size) != 0) {
+        talloc_free(buffer);
+        return NULL;
+    }
+
+    NSString *execPath = [[NSFileManager defaultManager]
+        stringWithFileSystemRepresentation:buffer
+                                    length:strlen(buffer)];
+    talloc_free(buffer);
+    if (!execPath)
+        return NULL;
+
+    execPath = [execPath stringByStandardizingPath];
+    NSString *macOSDir = [execPath stringByDeletingLastPathComponent];
+    if (![[macOSDir lastPathComponent] isEqualToString:@"MacOS"])
+        return NULL;
+
+    NSString *contentsDir = [macOSDir stringByDeletingLastPathComponent];
+    if (![[contentsDir lastPathComponent] isEqualToString:@"Contents"])
+        return NULL;
+
+    NSString *bundleDir = [contentsDir stringByDeletingLastPathComponent];
+    if ([[bundleDir pathExtension] caseInsensitiveCompare:@"app"] != NSOrderedSame)
+        return NULL;
+
+    NSString *resourcePath = [contentsDir stringByAppendingPathComponent:@"Resources"];
+    return talloc_strdup(talloc_ctx, [resourcePath UTF8String]);
+}
+
 const char *mp_get_platform_path_mac(void *talloc_ctx, const char *type)
 {
-    if (strcmp(type, "osxbundle") == 0 && getenv("MPVBUNDLE")) {
+    if (strcmp(type, "osxbundle") == 0) {
         NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
-        NSString *path = [[NSBundle mainBundle] resourcePath];
-        char *res = talloc_strdup(talloc_ctx, [path UTF8String]);
+        NSString *path = getenv("MPVBUNDLE") ? [[NSBundle mainBundle] resourcePath] : nil;
+        char *res = path ? talloc_strdup(talloc_ctx, [path UTF8String])
+                         : mac_bundle_resource_path_from_executable(talloc_ctx);
         [pool release];
         return res;
     }
