+static void prepend_lua_search_patterns(lua_State *L, const char *search_path,
+                                        const char * const *patterns)
+{
+    void *tmp = talloc_new(NULL);
+
+    lua_getglobal(L, "package"); // package
+    lua_getfield(L, -1, search_path); // package search_path
+
+    const char *current = lua_tostring(L, -1);
+    char *newpath = talloc_strdup(tmp, "");
+
+    for (int n = 0; patterns[n]; n++) {
+        if (patterns[n][0]) {
+            newpath = talloc_asprintf_append(newpath, "%s%s",
+                                             newpath[0] ? ";" : "",
+                                             patterns[n]);
+        }
+    }
+
+    if (current && current[0]) {
+        newpath = talloc_asprintf_append(newpath, "%s%s",
+                                         newpath[0] ? ";" : "",
+                                         current);
+    }
+
+    lua_pushstring(L, newpath);  // package search_path newpath
+    lua_setfield(L, -3, search_path); // package search_path
+    lua_pop(L, 2);  // -
+
+    talloc_free(tmp);
+}
+
+static void add_bundle_luarocks_paths(lua_State *L, struct script_ctx *ctx)
+{
+    void *tmp = talloc_new(NULL);
+    char *root = mp_get_user_path(tmp, ctx->mpctx->global,
+        "~~osxbundle/source-built/luarocks");
+    char *lua_dir = root ? mp_path_join(tmp, root, "share/lua/5.1") : NULL;
+    char *c_dir = root ? mp_path_join(tmp, root, "lib/lua/5.1") : NULL;
+
+    if (lua_dir && mp_path_isdir(lua_dir)) {
+        const char *patterns[] = {
+            mp_path_join(tmp, lua_dir, "?.lua"),
+            mp_path_join(tmp, lua_dir, "?/init.lua"),
+            NULL,
+        };
+        prepend_lua_search_patterns(L, "path", patterns);
+    }
+
+    if (c_dir && mp_path_isdir(c_dir)) {
+        const char *patterns[] = {
+            mp_path_join(tmp, c_dir, "?.so"),
+            NULL,
+        };
+        prepend_lua_search_patterns(L, "cpath", patterns);
+    }
+
+    talloc_free(tmp);
+}
